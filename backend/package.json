{
  "name": "nexus-control-backend",
  "version": "1.0.0",
  "description": "Backend API for Nexus Control",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx src/utils/migrate.js",
    "db:seed": "tsx src/utils/seed.ts",
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --roots dist/tests",
    "test:watch": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --roots dist/tests --watch"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^10.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
