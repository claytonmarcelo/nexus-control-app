# Test Environment Variables
# Copy this file to .env.test for running tests locally

# Test Database (can use same as development for local testing)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=nexusdb_test
DB_CONNECTION_LIMIT=5

# IMPORTANT: Test JWT Secrets (use different values from production)
JWT_SECRET=test_secret_key_change_in_production
JWT_REFRESH_SECRET=test_refresh_secret_key_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Test Admin Credentials (for authentication tests)
TEST_ADMIN_EMAIL=admin@nexuscontrol.com
TEST_ADMIN_PASSWORD=admin123

# Test User Credentials (for integration tests)
TEST_CLIENTE_EMAIL=cliente@nexuscontrol.com
TEST_CLIENTE_PASSWORD=cliente123

# Seed Demo Credentials (for demo account)
DEMO_ADMIN_EMAIL=admin.demo@nexuscontrol.com
DEMO_ADMIN_PASSWORD=999618

# Seed Test Credentials (for seed data)
SEED_FUNCIONARIO_PASSWORD=func123
SEED_CLIENTE_PASSWORD=cliente123

# Root Admin (real admin account - never commit real values)
ROOT_ADMIN_EMAIL=your.email@example.com
ROOT_ADMIN_NAME=Your Name
ROOT_ADMIN_PASSWORD=your_secure_password

# Server Configuration
PORT=3000
NODE_ENV=test
# IMPORTANT: In production, set this to your frontend URL (e.g., https://your-domain.com)
FRONTEND_URL=http://localhost:5173

# Email Configuration (optional for tests)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
