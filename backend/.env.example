PORT=3000
NODE_ENV=development
# Atenção: o dotenv trata '#' como início de comentário. Se um valor tiver '#',
# escreva entre aspas — DB_PASS="Minha#Senha" chega inteiro; sem aspas vira "Minha".
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=nexusdb
DB_CONNECTION_LIMIT=5
JWT_SECRET=replace_with_a_unique_random_secret_of_32_chars
JWT_REFRESH_SECRET=replace_with_another_unique_random_secret_of_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
ROOT_ADMIN_EMAIL=marcelo10@gmail.com
ROOT_ADMIN_NAME=Marcelo
# Novas senhas: 5 ou 6 dígitos seguidos de exatamente 1 símbolo (6 ou 7 caracteres).
# Válidas: 12345@ · 123456$ | Inválidas: 1234@ · 1234567@ · 12345a
# Se o valor contiver #, coloque entre aspas: ROOT_ADMIN_PASSWORD="123456#"
ROOT_ADMIN_PASSWORD=
# Em desenvolvimento: http://localhost:5173
# Em produção: URL pública do frontend (ex: https://seu-dominio.com ou https://seu-ip:porta)
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Pagamentos (Mercado Pago) ---
# Sem MP_ACCESS_TOKEN o fluxo continua em modo manual (confirmação pelo
# administrador) — as regras de liberação são as mesmas nos dois caminhos.
# NUNCA coloque tokens reais versionados; use apenas variáveis de ambiente.
MP_ACCESS_TOKEN=
# Segredo do webhook (painel do Mercado Pago) — valida a assinatura HMAC do
# x-signature. Sem ele, o webhook rejeita eventos e a confirmação segue manual.
MP_WEBHOOK_SECRET=
# URL pública deste backend (usada como notification_url do gateway).
PUBLIC_URL=
