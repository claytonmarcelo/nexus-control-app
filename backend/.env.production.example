# Modelo de ambiente para produção (AWS Academy / EC2).
# Copie para backend/.env e SUBSTITUA todos os valores de exemplo.
# NUNCA faça commit deste arquivo preenchido nem de segredos reais (§96/§119).
# As chaves de validação em produção exigem segredo com 32+ caracteres,
# JWT_SECRET diferente de JWT_REFRESH_SECRET e sem valores de exemplo.

NODE_ENV=production
PORT=3000

# --- Banco (RDS MySQL) ---
DB_HOST=<rds-endpoint>.<regiao>.rds.amazonaws.com
DB_PORT=3306
DB_USER=<usuario-da-aplicacao>
DB_PASS=<senha-forte-do-mysql>
DB_NAME=nexusdb
DB_CONNECTION_LIMIT=5
# Em RDS use SSL. Se o certificado for auto-assinado, defina REJECT=false.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Autenticação (obrigatórios e únicos em produção) ---
# Gere cada segredo com, no mínimo, 32 caracteres aleatórios (ex.: openssl rand -hex 32)
JWT_SECRET=<gere_um_segredo_aleatorio_com_32+_caracteres>
JWT_REFRESH_SECRET=<gere_outro_segredo_aleatorio_diferente_com_32+_caracteres>
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# --- Administrador raiz (sua conta pessoal) ---
ROOT_ADMIN_EMAIL=<seu-email-de-administrador>
ROOT_ADMIN_NAME=<seu-nome>
# Política de senha: 5 ou 6 dígitos seguidos de exatamente 1 símbolo (6 ou 7 caracteres).
# Ex.: 12345@ · 123456$  |  inválidos: 1234@ · 1234567@ · 12345a
ROOT_ADMIN_PASSWORD=

# Atenção ao '#' em qualquer valor: o dotenv o trata como início de comentário, então
# DB_PASS="Senha#Forte" precisa de aspas — sem elas o processo recebe apenas "Senha" e o
# MySQL responde ER_ACCESS_DENIED_ERROR (using password: YES).

# --- URLs públicas ---
# FRONTEND_URL: origem pública do frontend, sem caminho final.
# API_URL: origem pública da API, sem /api.
FRONTEND_URL=https://seu-dominio-aws.com
API_URL=https://api.seu-dominio-aws.com

# --- Email / recuperação de senha (opcional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Pagamentos (Mercado Pago) — OPCIONAL ---
# Deixe em branco para o modo manual (Pix/crédito confirmado pelo administrador).
# Configure apenas via ambiente; jamais versione tokens reais.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL pública deste backend (notification_url do gateway e base do webhook).
PUBLIC_URL=
